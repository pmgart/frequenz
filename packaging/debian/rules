#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	desktop-file-validate frequenzradio/data/se.laps.Frequenz.desktop
	appstreamcli validate --no-net frequenzradio/data/se.laps.Frequenz.metainfo.xml
	python3 -m pytest -q

override_dh_auto_install:
	dh_auto_install
	install -Dm644 frequenzradio/data/se.laps.Frequenz.desktop \
		debian/frequenz/usr/share/applications/se.laps.Frequenz.desktop
	install -Dm644 frequenzradio/data/se.laps.Frequenz.metainfo.xml \
		debian/frequenz/usr/share/metainfo/se.laps.Frequenz.metainfo.xml
	for size in 16 24 32 48 64 128 256 512; do \
		install -Dm644 frequenzradio/data/icons/hicolor/$${size}x$${size}/apps/se.laps.Frequenz.png \
			debian/frequenz/usr/share/icons/hicolor/$${size}x$${size}/apps/se.laps.Frequenz.png; \
	done
